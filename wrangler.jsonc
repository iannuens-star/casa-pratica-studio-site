// Worker do site + painel do celular.
// "name" é o Worker que já serve app.casapraticastudio.com.br (domínio personalizado).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-pratica-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // só o painel passa pelo código; o resto continua estático
    "run_worker_first": ["/painel", "/painel/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tiktokshop-2026" }],
  "observability": { "enabled": true }
  // Segredos (nunca neste arquivo): npx wrangler secret put PAINEL_SENHA e SESSAO_SEGREDO
}
